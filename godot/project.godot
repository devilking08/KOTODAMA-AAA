; Engine configuration file.
; KOTODAMA — Godot 4 port (godogen workflow).
; Low-spec profile: GL Compatibility renderer, software-friendly scaling,
; no shadows, capped ticks. Designed to run without a discrete GPU.

config_version=5

[application]

config/name="KOTODAMA: Echoes of the Nameless"
config/description="The world forgot its name. You remember. Godot port."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

