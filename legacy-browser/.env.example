# ─────────────────────────────────────────────────────────────────────────────
# KOTODAMA — environment template
# Copy to `.env` only if you enable optional services. The game itself runs
# fully offline and requires ZERO credentials. Every value below is optional.
# ─────────────────────────────────────────────────────────────────────────────

# Build metadata (shown in Settings → About)
VITE_APP_VERSION=1.0.0
VITE_BUILD_COMMIT=
VITE_BUILD_TIME=

# Deployment base path. Keep "./" for GitHub Pages / itch.io / offline builds.
VITE_BASE_PATH=./

# Optional: public analytics endpoint (no PII, no cookies). Leave blank to disable.
VITE_ANALYTICS_URL=
VITE_ANALYTICS_SITE_ID=

# Optional: error reporting (Sentry-compatible DSN). Leave blank to disable.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production

# Optional: feature flags
VITE_ENABLE_PHOTO_MODE=true
VITE_ENABLE_DEVTOOLS=false
VITE_ENABLE_EXPERIMENTAL_UPSCALER=false

# Tooling only — NEVER expose in the browser, NEVER commit a real token.
# Used by `tools/research/collect.mjs` to raise GitHub API rate limits.
GITHUB_TOKEN=
GH_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
