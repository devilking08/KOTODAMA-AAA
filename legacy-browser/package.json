{
  "name": "kotodama-echoes-of-the-nameless",
  "private": true,
  "version": "1.0.0",
  "description": "KOTODAMA: Echoes of the Nameless — a cinematic, open-zone 3D action game for the browser. Ten chapters. Five weapons. One name left to speak.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && vite build",
    "screenshot": "node tools/screenshots.mjs",
    "research": "node tools/research/collect.mjs"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/three": "^0.187.0",
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "~5.9.3",
    "vite": "^8.3.6",
    "vitest": "^3.2.4"
  }
}
