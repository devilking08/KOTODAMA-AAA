# Copy this file to .env and fill in real values. Never commit .env.
# All integrations use these exact variable names.

# GitHub (publishing / automation)
GH_TOKEN=ghp_xxx
GITHUB_TOKEN=ghp_xxx

# Godot MCP (editor automation; run `node godot-mcp/server/build/index.js`)
GODOT_MCP_PORT=8765

# Vision review (Nemotron-VL via api.opensource.tools, optional)
VISION_API_KEY=
VISION_MODEL=nemotron-vl-84b

# TTS / voice (ChatTTS / ACE-Step / Chatterbox references)
CHATTTS_CACHE_DIR=./tools/tts/cache
ACE_STEP_CACHE_DIR=./tools/tts/ace-step-cache
OPENAI_API_KEY=

# Audio2Face (NVIDIA, lip-sync references â€” license: non-commercial demo)
A2F_ROOT=./tools/a2f

# Roblox (publishing + DataStore; fill only when publishing a live place)
ROBLOX_API_KEY=rbx_xxx
ROBLOX_PLACE_ID=
